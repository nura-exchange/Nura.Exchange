# WalletConnect Project ID (required for WalletConnect QR code / mobile wallet connections)
# Get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Vercel deployment URL (used as wallet-facing RPC endpoint for chain config)
VITE_VERCEL_URL=https://arcfx-app.vercel.app

# Dev / Deployment (keep empty for production)
# VITE_DEPLOYER_PRIVATE_KEY=
